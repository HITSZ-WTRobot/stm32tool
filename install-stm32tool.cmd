@echo off
setlocal

:: ==========================================================
set "B64_"
:: ==========================================================

set "PS_SCRIPT=%TEMP%\install-stm32tool.ps1"

echo [*] Decoding installer...

powershell -NoProfile -Command ^
    "[System.IO.File]::WriteAllBytes('%PS_SCRIPT%', [System.Convert]::FromBase64String('%B64_DATA%'))"

echo [*] Running installer...
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS_SCRIPT%"

if exist "%PS_SCRIPT%" del "%PS_SCRIPT%"

pause